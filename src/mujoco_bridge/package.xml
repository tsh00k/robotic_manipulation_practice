<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mujoco_bridge</name>
  <version>0.0.1</version>
  <description>Bridges a MuJoCo simulation to ROS2: publishes clock/joint states/TF/RGB-D/ground-truth, accepts joint/torque/gripper commands, provides a reset service.</description>
  <maintainer email="z5pknq@example.com">anby</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_srvs</depend>
  <depend>ament_index_cpp</depend>
  <depend>robot_description</depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>arm_kinematics</test_depend>
  <test_depend>franka_description</test_depend>
  <test_depend>moveit_core</test_depend>
  <test_depend>xacro</test_depend>

  <!-- grasp_criteria is an exported ament_cmake library target (CMakeLists.txt),
       so downstream packages (task_executor) can find_package(mujoco_bridge) and
       target_link_libraries(... mujoco_bridge::grasp_criteria) instead of
       reimplementing classifyGrasp(). -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
