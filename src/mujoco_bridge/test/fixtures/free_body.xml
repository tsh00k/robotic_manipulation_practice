<mujoco model="free_body_fixture">
  <!-- Minimal scene for test_state_ops: one free-joint body (nq=7, nv=6) plus one
       hinge joint on a second body, so the hinge's qpos_adr (7) and dof_adr (6)
       differ: a jnt_qposadr/jnt_dofadr mixup on the hinge is silently wrong on
       Panda alone (nq == nv there) but wrong-and-detectable here. -->
  <worldbody>
    <body name="box" pos="0 0 0.1">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02"/>
    </body>
    <body name="arm" pos="0.5 0 0.1">
      <joint name="hinge" type="hinge" axis="0 0 1"/>
      <geom type="capsule" size="0.01" fromto="0 0 0 0.1 0 0"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home" time="0" qpos="0.1 0.2 0.3 1 0 0 0 0.5"/>
  </keyframe>
</mujoco>
